{
  "name": "claude-course-interactive",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate --schema=./prisma/schema.local.prisma && next dev",
    "build": "prisma generate && next build",
    "db:generate": "prisma generate",
    "db:generate:local": "prisma generate --schema=./prisma/schema.local.prisma",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "prisma db push",
    "db:push:local": "prisma db push --schema=./prisma/schema.local.prisma",
    "db:studio": "prisma studio",
    "db:studio:local": "prisma studio --schema=./prisma/schema.local.prisma"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@auth/prisma-adapter": "^2.7.4",
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@next/mdx": "^15.0.3",
    "@prisma/client": "^5.22.0",
    "mermaid": "^11.4.1",
    "next": "^15.0.3",
    "next-auth": "5.0.0-beta.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shiki": "^1.24.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.0.3",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
