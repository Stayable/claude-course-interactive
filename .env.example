# =============================================================================
# Local development
# =============================================================================
# Copy this file to `.env` and fill in.

# Anthropic API key — server-side only. Never expose to the browser.
ANTHROPIC_API_KEY=

# Auth.js — generate with: openssl rand -base64 32
# (On Windows PowerShell: [Convert]::ToBase64String((1..32 | %{Get-Random -Maximum 256})))
AUTH_SECRET=

# GitHub OAuth (create at https://github.com/settings/developers)
# Local: Homepage URL = http://localhost:3000
#        Authorization callback URL = http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Prisma — local uses SQLite by default (schema.local.prisma)
DATABASE_URL="file:./dev.db"

# =============================================================================
# Production (Vercel)
# =============================================================================
# These get set in the Vercel dashboard under Project Settings → Environment Variables.
# Do NOT commit a real .env file. Below is the shape only.
#
# ANTHROPIC_API_KEY=sk-ant-...
# AUTH_SECRET=<openssl rand -base64 32 output>
# AUTH_GITHUB_ID=<from production GitHub OAuth app>
# AUTH_GITHUB_SECRET=<from production GitHub OAuth app>
# DATABASE_URL=postgres://<neon-connection-string>?sslmode=require
#
# Vercel auto-provides:
# - NEXTAUTH_URL (preview URLs + prod URL automatically)
# - VERCEL_URL
#
# For the production GitHub OAuth app:
# - Homepage URL = https://<your-vercel-domain>
# - Authorization callback URL = https://<your-vercel-domain>/api/auth/callback/github
